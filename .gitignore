# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Build output
dist/
build/
target/
*.log

# Environment / secrets
.env
.env.*
!.env.example

# Editor / OS
.idea/
.vscode/
.DS_Store

# Scratch space for transient artifacts — never committed (Constitution XII)
.temp/*
!.temp/.gitkeep

