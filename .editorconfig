# EditorConfig is awesome: https://editorconfig.org
#
# Single source of truth for mechanical file formatting in this repo.
# Where a language has its own formatter (rustfmt, taplo, shfmt, prettier),
# that formatter is AUTHORITATIVE and this file MIRRORS it so editors agree
# with CI. Governed by Constitution Principle IX.
#
# Adding a new file type? Add a section here and confirm it matches the
# language's canonical formatter before committing.

root = true

# ---- Defaults: apply to every file unless overridden below ----
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

# ---- Rust: mirrors `rustfmt` defaults (rustfmt is authoritative) ----
[*.rs]
indent_size = 4
max_line_length = 100

# ---- TOML: Cargo manifests, config (taplo default is 2-space) ----
[*.toml]
indent_size = 2

# ---- YAML: Kubernetes manifests, spec-kit config, Helm templates ----
# *.tpl are Go-templated YAML (Helm); share the YAML indentation rules.
[*.{yml,yaml,tpl}]
indent_size = 2

# ---- JSON: spec-kit manifests, tool config ----
[*.json]
indent_size = 2

# ---- Markdown: 2-space; KEEP trailing whitespace (hard line breaks),
#      no line-length cap (prose wraps naturally) ----
[*.md]
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

# ---- Shell: spec-kit bash scripts (shfmt-compatible) ----
[*.{sh,bash}]
indent_size = 2
binary_next_line = true
switch_case_indent = true

# ---- PowerShell: spec-kit powershell scripts ----
[*.{ps1,psm1,psd1}]
indent_size = 4

# ---- Python: spec-kit helper scripts (PEP 8) ----
[*.py]
indent_size = 4
max_line_length = 100

# ---- Gherkin: cucumber-rs .feature files (Constitution Principle VI BDD) ----
[*.feature]
indent_size = 2

# ---- dotenv (.env) config files: flat KEY=VALUE (spec-009) ----
[{.env,.env.*,*.env}]
indent_size = 2

# ---- Dockerfile: container image for the webhook Deployment ----
[{Dockerfile,*.containerfile,*.dockerfile}]
indent_size = 4

# ---- Makefile: recipes REQUIRE hard tabs (make enforces this) ----
[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab
indent_size = 8
