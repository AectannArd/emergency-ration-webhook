# ERW Verify — Real Infrastructure Test Configuration (spec-009)
#
# Copy this file to `.env` (in the repo root) and fill in your values, then run:
#   ./target/release/erw-verify
#
# `.env` is git-ignored and never committed; this template is the documented
# configuration contract. Precedence for every variable (highest first):
#   CLI flag  >  .env file  >  ambient env var  >  compiled default

# Container registry endpoint, WITHOUT a protocol scheme
# (e.g. cr.yandex/crppbh5k4v76t4ml9u8f, ghcr.io/owner).
# Required unless --skip-build is set.
ERW_REGISTRY=

# Image name within the registry (default: capacity-admission-webhook).
ERW_IMAGE_NAME=capacity-admission-webhook

# Image tag (default: latest).
ERW_IMAGE_TAG=latest

# Path to the kubeconfig for the target cluster. Relative paths resolve against
# the repo root (the tool's working directory). Optional: falls back to
# --kubeconfig, then the ambient KUBECONFIG, then Config::infer (~/.kube/config).
ERW_KUBECONFIG=

# Skip the Docker build+push phase and reuse an already-pushed image.
# Uncomment and set to 1 (or true) to enable.
# ERW_SKIP_BUILD=1
